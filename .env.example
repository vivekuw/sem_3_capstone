# ==============================================================================
# Chemical Process RCA Agent - Environment Template (.env.example)
# Copy this file to .env and adjust parameters as needed.
# ==============================================================================

# TimescaleDB Configuration
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=plant_data
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=your_timescale_password_here

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_BROWSER_URL=http://localhost:7474

# FastAPI Service Configuration
API_HOST=127.0.0.1
API_PORT=8009
